<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.post.ListPostFragment">

    <!-- Cabecera con foto de perfil y cuadro de búsqueda -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/search_box"
            style="@style/CustomEditTextStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:layout_gravity="center_vertical"
            android:hint="Buscar posts"
            android:inputType="text"
            android:maxLines="1"
            android:padding="8dp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/sorted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sorted"
            android:layout_gravity="center_vertical"
            android:padding="8dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profile_picture"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Profile Image"
            android:outlineSpotShadowColor="@color/black"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Circle"
            android:padding="8dp" />

    </LinearLayout>

    <!--separator-->
    <View
        android:id="@+id/separador"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/rojo1"
        android:elevation="100dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--Spinner para filtrar por categoría-->
    <RelativeLayout
        android:id="@+id/spinner_layout"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/separador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="350dp"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/CustomEditTextStyle"
            android:spinnerMode="dropdown"
            android:layout_marginTop="20dp"/>

        <ImageView
            android:id="@+id/spinner_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_arrow_down"/>

    </RelativeLayout>

    <!-- RecyclerView para mostrar posts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_posts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/spinner_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation" />

    <!-- Barra de progreso en el centro de la pantalla -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/rojo1"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header" />

    <!-- linea separadora -->
    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/rojo1"
        android:elevation="100dp"
        app:layout_constraintTop_toBottomOf="@id/recycler_view_posts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="@color/rojo1"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modal para perfil -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aux"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/transparente"
        android:visibility="visible"/>


    <FrameLayout
        android:id="@+id/profile_modal"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="101dp"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/profile_picture_large"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:src="@drawable/profile_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_shape" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Nombre Apellido"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

            <View
                android:id="@+id/separador1"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/profile_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/see_profile_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="Ver perfil"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_account"
                android:drawablePadding="8dp" />

            <View
                android:id="@+id/separador7"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/see_profile_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="Configuración"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_settings"
                android:drawablePadding="8dp" />

            <View
                android:id="@+id/separador2"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/settings_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="Calendario"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_calendar"
                android:drawablePadding="8dp" />

            <View
                android:id="@+id/separador8"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/calendar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/logout_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="Cerrar sesión"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_exit"
                android:drawablePadding="8dp" />

            <View
                android:id="@+id/separador3"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/logout_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/cerrar_modal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="Cerrar"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_close"
                android:drawablePadding="8dp" />

            <View
                android:id="@+id/separador4"
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_gravity="center"
                android:elevation="100dp"
                app:layout_constraintTop_toBottomOf="@id/cerrar_modal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </LinearLayout>
    </FrameLayout>

    <!-- Modal para orden -->
    <FrameLayout
        android:id="@+id/sort_modal"
        style="@style/CustomEditTextStyle"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="102dp"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <ImageView
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:src="@drawable/ic_close"
                android:padding="8dp" />

            <TextView
                android:id="@+id/sort_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:text="Ordenar posts"
                android:textColor="@color/rojo1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/sort_chronological"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                android:buttonTint="@color/rojo1"
                android:text="Por fecha"
                android:textColor="@color/black" />

            <CheckBox
                android:id="@+id/sort_relevance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                android:buttonTint="@color/rojo1"
                android:text="Por relevancia"
                android:textColor="@color/black" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
